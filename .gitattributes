# Shell scripts MUST keep LF endings: a CRLF setup.sh fails on Linux with
# "bad interpreter: /usr/bin/env bash^M". This is enforced regardless of the
# contributor's core.autocrlf setting.
* text=auto eol=lf

*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.conf   text eol=lf
LICENSE  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
